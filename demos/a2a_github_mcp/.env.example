# A2A MCP Lab Environment Variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token
# Required for GitHub MCP server to access repositories
# Create one at: https://github.com/settings/tokens
# Required permissions: repo (for private repos), public_repo (for public repos)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# LiteLLM Configuration
# Base URL for LiteLLM proxy server
LITELLM_BASE_URL=http://localhost:4000

# LiteLLM API Key (if required by your proxy)
LITELLM_API_KEY=your_litellm_api_key_here

# Model Configuration
# Model name to use (e.g., gpt-4o, gpt-4, gpt-3.5-turbo)
# MODEL_NAME takes precedence over LITELLM_MODEL if both are set
LITELLM_MODEL=gpt-5.2

# Alternative: Use LITELLM_MODEL if MODEL_NAME is not set
# LITELLM_MODEL=gpt-4o

# Streamlit Configuration (optional)
STREAMLIT_PORT=8501
