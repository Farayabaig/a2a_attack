# LLM Provider Selection
# Options: 'anthropic' or 'litellm'
LLM_PROVIDER=anthropic

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# LiteLLM Configuration (required if LLM_PROVIDER=litellm)
LITELLM_BASE_URL=https://your-litellm-server.com
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_MODEL=bedrock/meta.llama2-13b-chat-v1

# Model Configuration (backward compatibility - deprecated)
# Use ANTHROPIC_MODEL or LITELLM_MODEL instead
MODEL=
MAX_TOKENS=2048

# Simulation Settings
ENABLE_ACTUAL_API_CALLS=true
VERBOSE_LOGGING=true

# Security Settings
LOG_ALL_INTERACTIONS=true
